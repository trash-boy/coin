# Copy this file to .env and fill in your real keys.
#   cp .env.example .env
#   chmod 600 .env
# Load it with:
#   set -a && source .env && set +a

# ========================================
# Stage 1: Testnet (use this for the first 2 weeks)
# Apply: https://testnet.binancefuture.com
# ========================================
BINANCE_API_KEY="testnet_xxx"
BINANCE_API_SECRET="testnet_yyy"
COIN_ENV="testnet"

# ========================================
# Stage 2: Production mainnet (only after testnet validation)
# Apply: https://www.binance.com/en/my/settings/api-management
# Required permissions:  Reading + Futures
# Forbidden permissions: Withdrawals, Universal Transfer
# IP whitelist: REQUIRED
# ========================================
# BINANCE_API_KEY="prod_xxx"
# BINANCE_API_SECRET="prod_yyy"
# COIN_ENV="prod"
